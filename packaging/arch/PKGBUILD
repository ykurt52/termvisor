# Maintainer: Yunus Kurt <yunuskkurt@gmail.com>
pkgname=termvisor
pkgver=0.1.0
pkgrel=1
pkgdesc='Multi-protocol terminal and remote access tool'
arch=('x86_64' 'aarch64')
url='https://github.com/ykurt52/termvisor'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'libsecret' 'systemd-libs' 'glib2' 'cairo' 'pango' 'openssh')
makedepends=('cargo')
optdepends=('mosh: mosh sessions'
            'android-tools: Android shell, logcat and files'
            'iputils: ping and tracepath tools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/termvisor "$pkgdir/usr/bin/termvisor"
  install -Dm644 data/io.github.ykurt52.termvisor.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/io.github.ykurt52.termvisor.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.ykurt52.termvisor.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs/"
}
